#!/bin/bash
# Launch Time Doctor under Hyprland on its X11 code paths (XWayland), with the
# Wayland ports running beside it. Installed next to td-waylandshot.so and
# td-inputbridge by `make install`.

BUILD=$(dirname "$(readlink -f "$0")")
TIMEDOCTOR_DIR=${TIMEDOCTOR_DIR:-$HOME/timedoctor}
export TD_SHOT_LOG="${TD_SHOT_LOG:-$HOME/.cache/td-waylandshot.log}"
# The preloaded library starts td-inputbridge (keyboard/mouse activity into
# XWayland) for each Time Doctor, a self-restarted one included.
export LD_PRELOAD="$BUILD/td-waylandshot.so${LD_PRELOAD:+:$LD_PRELOAD}"
export QT_QPA_PLATFORM=xcb XDG_SESSION_TYPE=x11
# 3.20+ treats a set WAYLAND_DISPLAY as a Wayland session (the shim answers its
# loginctl query); the shim hands this copy to grim.
export TD_WAYLAND_DISPLAY="$WAYLAND_DISPLAY"
unset WAYLAND_DISPLAY
exec "$TIMEDOCTOR_DIR/timedoctor" "$@"
